{
  "name": "railsync-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "RailSync: Intelligent Railway Decision Support & Real-Time Predictive Transit Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "cd backend && python -m pytest tests/",
    "dev:backend": "cd backend && python -m uvicorn api.main:app --host 127.0.0.1 --port 8000 --reload",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "railway",
    "transit",
    "prediction",
    "kinematics",
    "fastapi",
    "nextjs"
  ],
  "author": "Aryan Raj",
  "license": "ISC"
}
